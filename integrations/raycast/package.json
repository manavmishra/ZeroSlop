{
  "$schema": "https://www.raycast.com/schemas/extension.json",
  "name": "zero-slop",
  "type": "module",
  "title": "Zero Slop Writing Editor",
  "description": "Edit selected writing with Zero Slop, review the result, then copy or paste it yourself.",
  "icon": "icon.png",
  "author": "manavmishra",
  "platforms": [
    "macOS"
  ],
  "categories": [
    "Productivity",
    "Communication"
  ],
  "keywords": [
    "editing",
    "writing",
    "rewrite",
    "AI",
    "MCP"
  ],
  "license": "MIT",
  "version": "2.10.0",
  "commands": [
    {
      "name": "edit-selection",
      "title": "Edit Selected Text",
      "subtitle": "Zero Slop",
      "description": "Preview selected text, send it to the hosted Zero Slop editor, and review before pasting.",
      "mode": "view"
    }
  ],
  "dependencies": {
    "@raycast/api": "2.2.0",
    "zero-slop": "2.10.0"
  },
  "devDependencies": {
    "@raycast/eslint-config": "2.2.0",
    "@types/node": "22.19.17",
    "@types/react": "19.0.10",
    "eslint": "9.39.5",
    "prettier": "3.9.6",
    "react-devtools": "6.1.1",
    "typescript": "5.9.3"
  },
  "overrides": {
    "typescript-eslint": "8.62.0"
  },
  "scripts": {
    "build": "ray build -e dist",
    "dev": "ray develop",
    "lint": "ray lint",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test test/*.test.ts",
    "publish": "ray publish"
  }
}
