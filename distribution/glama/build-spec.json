{
  "baseImage": "debian:trixie-slim",
  "nodeVersion": "24",
  "pythonVersion": "3.14",
  "buildSteps": [
    "npm ci --prefix distribution/glama --ignore-scripts --no-fund --no-audit"
  ],
  "cmdArguments": [
    "node",
    "distribution/glama/node_modules/mcp-proxy/dist/bin/mcp-proxy.mjs",
    "--",
    "node",
    "distribution/glama/node_modules/mcp-remote/dist/proxy.js",
    "https://mcp.zero-slop.ai/mcp",
    "--transport",
    "http-only",
    "--silent"
  ],
  "environmentVariablesJsonSchema": {
    "type": "object",
    "properties": {},
    "additionalProperties": false
  },
  "placeholderParameters": {}
}
