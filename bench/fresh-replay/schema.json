{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "rewrites": {
      "type": "array",
      "minItems": 1,
      "maxItems": 18,
      "items": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "text": { "type": "string", "minLength": 1 }
        },
        "required": ["id", "text"],
        "additionalProperties": false
      }
    }
  },
  "required": ["rewrites"],
  "additionalProperties": false
}
